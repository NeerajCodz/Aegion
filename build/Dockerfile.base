# =============================================================================
# Aegion Base Build Image
# Contains the Go toolchain and shared build dependencies
# =============================================================================
FROM golang:1.25.10-bookworm AS base

# Install build dependencies
RUN apt-get update && apt-get install -y \
    protobuf-compiler \
    libprotobuf-dev \
    pkg-config \
    libssl-dev \
    clang \
    lld \
    && rm -rf /var/lib/apt/lists/*

# Install Go tools (with specific versions for reproducibility)
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.10 && \
    go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.5.1 && \
    go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.5.0

# Set working directory
WORKDIR /build

# Labels
LABEL org.opencontainers.image.title="Aegion Base Build" \
      org.opencontainers.image.description="Build image with the Go toolchain" \
      org.opencontainers.image.vendor="Aegion"
