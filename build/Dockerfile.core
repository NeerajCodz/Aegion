# =============================================================================
# Aegion Core Dockerfile
# Builds the main core binary with Go-native crypto/JWT
# =============================================================================

ARG BASE_IMAGE=golang:1.25.10-bookworm
ARG RUNTIME_IMAGE=gcr.io/distroless/cc-debian13:nonroot

# Stage 1: Build Go binary
FROM ${BASE_IMAGE} AS go-builder

WORKDIR /build

# Copy go modules first for caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the core binary
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -ldflags="-s -w -X main.version=${VERSION}" \
    -o /build/aegion ./cmd/aegion

# Stage 2: Final runtime image
FROM ${RUNTIME_IMAGE}

ENV TZ=UTC
WORKDIR /app

# Copy binary
COPY --from=go-builder /build/aegion /app/aegion

# Copy default config
COPY configs/aegion.yaml /config/aegion.yaml

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/app/aegion", "health"]

# Entry point
ENTRYPOINT ["/app/aegion"]
CMD ["serve", "--config", "/config/aegion.yaml"]
