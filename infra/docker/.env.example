# Aegion Docker development environment
# Copy this file to .env and replace secrets before sharing a deployment.

AEGION_CORE_IMAGE=aegion/aegion-core:dev
AEGION_ADMIN_IMAGE=aegion/aegion-admin:dev
AEGION_ANALYTICS_IMAGE=aegion/aegion-analytics:dev
AEGION_OAUTH2_IMAGE=aegion/aegion-oauth2:dev
AEGION_SOCIAL_IMAGE=aegion/aegion-social:dev
AEGION_SSO_IMAGE=aegion/aegion-sso:dev
AEGION_INTROSPECTION_IMAGE=aegion/aegion-introspection:dev
AEGION_PROXY_IMAGE=aegion/aegion-proxy:dev
AEGION_MFA_IMAGE=aegion/aegion-mfa:dev
AEGION_PASSKEYS_IMAGE=aegion/aegion-passkeys:dev
AEGION_CLI_IMAGE=aegion/aegion-cli:dev
LOZA_IMAGE=astraive/loza
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.106.1
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
TEMPO_IMAGE=grafana/tempo:2.6.1
GRAFANA_IMAGE=grafana/grafana:11.2.2
MAILPIT_IMAGE=axllent/mailpit:v1.21.8

POSTGRES_DB=aegion
POSTGRES_USER=aegion
POSTGRES_PASSWORD=change-me

# Aegion core: host 9000, pprof 9001, registry gRPC 9002.
AEGION_CORE_HOST_PORT=9000
AEGION_CORE_CONTAINER_PORT=8080
AEGION_PPROF_HOST_PORT=9001
AEGION_PPROF_CONTAINER_PORT=6060
AEGION_REGISTRY_HOST_PORT=9002
AEGION_REGISTRY_CONTAINER_PORT=9443

# Aegion modules: host ports are allocated in module order.
AEGION_ADMIN_HOST_PORT=9100
AEGION_ADMIN_CONTAINER_PORT=8082
AEGION_ANALYTICS_HOST_PORT=9101
AEGION_ANALYTICS_CONTAINER_PORT=8080
AEGION_OAUTH2_HOST_PORT=9102
AEGION_OAUTH2_CONTAINER_PORT=8083
AEGION_SOCIAL_HOST_PORT=9103
AEGION_SOCIAL_CONTAINER_PORT=9006
AEGION_SSO_HOST_PORT=9104
AEGION_SSO_CONTAINER_PORT=9007
AEGION_INTROSPECTION_HOST_PORT=9105
AEGION_INTROSPECTION_CONTAINER_PORT=9008
AEGION_PROXY_HOST_PORT=9106
AEGION_PROXY_CONTAINER_PORT=9009
AEGION_MFA_HOST_PORT=9107
AEGION_MFA_CONTAINER_PORT=9003
AEGION_PASSKEYS_HOST_PORT=9108
AEGION_PASSKEYS_CONTAINER_PORT=9004

# Supporting services: host ports continue after the module range.
POSTGRES_HOST_PORT=9200
POSTGRES_CONTAINER_PORT=5432
REDIS_HOST_PORT=9201
REDIS_CONTAINER_PORT=6379
OTEL_GRPC_HOST_PORT=9202
OTEL_GRPC_CONTAINER_PORT=4317
OTEL_HTTP_HOST_PORT=9203
OTEL_HTTP_CONTAINER_PORT=4318
OTEL_METRICS_HOST_PORT=9204
OTEL_METRICS_CONTAINER_PORT=8889
OTEL_HEALTH_HOST_PORT=9205
OTEL_HEALTH_CONTAINER_PORT=13133
PROMETHEUS_HOST_PORT=9206
PROMETHEUS_CONTAINER_PORT=9090
TEMPO_HOST_PORT=9207
TEMPO_CONTAINER_PORT=3200
GRAFANA_HOST_PORT=9208
GRAFANA_CONTAINER_PORT=3000
MAILPIT_UI_HOST_PORT=9209
MAILPIT_UI_CONTAINER_PORT=8025
MAILPIT_SMTP_HOST_PORT=9210
MAILPIT_SMTP_CONTAINER_PORT=1025

LOZA_HTTP_HOST_PORT=9308
LOZA_HTTP_CONTAINER_PORT=9308
LOZA_GRPC_HOST_PORT=9309
LOZA_GRPC_CONTAINER_PORT=9309
LOZA_GRAPHQL_HOST_PORT=9310
LOZA_GRAPHQL_CONTAINER_PORT=9310
LOZA_TAIL_HOST_PORT=9311
LOZA_TAIL_CONTAINER_PORT=9311

AEGION_LOZA_COLLECTOR_URL=http://loza-collector:9308/events
AEGION_LOZA_API_KEY=lx_sec_dev_kingest_dev-ingest-key-change-me
LOZA_INGEST_KEY_SECRET=dev-ingest-key-change-me
LOZA_ADMIN_KEY_SECRET=dev-admin-key-change-me
LOZA_COLLECTOR_AUTH_SERVER_SECRET=dev-server-secret-change-me
LOZA_STORAGE_ENCRYPTION_KEY=dev-storage-encryption-key-change-me
